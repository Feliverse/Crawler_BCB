{
    "id_fuente":  "data_gov",
    "nombre":  "Portal de Datos Abiertos de Estados Unidos",
    "base_url":  "https://www.data.gov/",
    "allowed_domains":  [
                            "data.gov"
                        ],
    "entrypoints":  [
                        "https://www.data.gov/"
                    ],
    "extensions":  [
                       ".pdf",
                       ".xlsx",
                       ".xls",
                       ".csv",
                       ".doc",
                       ".docx",
                       ".zip",
                       ".ods",
                       ".txt"
                   ],
    "max_depth":  3,
    "max_pages":  25,
    "max_files":  500,
    "delay_seconds":  0.8,
    "request_timeout":  20,
    "inspect_zips":  true
}
