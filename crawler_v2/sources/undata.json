{
  "id_fuente": "undata",
  "nombre": "United Nations Data",
  "base_url": "https://data.un.org/",
  "allowed_domains": [
    "data.un.org"
  ],
  "entrypoints": [
    "https://data.un.org/",
    "https://data.un.org/Host.aspx?Content=API",
    "https://data.un.org/ws/",
    "https://data.un.org/ws/rest/dataflow/"
  ],
  "max_depth": 4,
  "max_pages": 400,
  "max_files": 5000,
  "request_timeout": 20,
  "delay_seconds": 0.3,
  "random_delay_min": 0.3,
  "random_delay_max": 0.9,
  "auto_url_variants": false,
  "discover_sitemaps": false,
  "discover_openapi_endpoints": true,
