      "url": "https://data.un.org/ws/rest/dataflow/",
      "descripcion": "UNData SDMX - Catálogo de Dataflows",
      "method": "GET",
      "documentation_url": "https://data.un.org/Host.aspx?Content=API"
    }
  ],
  "include_url_patterns": [
    "/Host.aspx?Content=API",
    "/ws/",
    "/Data.aspx",
    "/DocumentData.aspx",
    "/Search.aspx",
    "/Explorer.aspx",
    "/Handlers/DownloadHandler.ashx",
    ".csv",
    ".xml",
    ".json",
    ".zip"
