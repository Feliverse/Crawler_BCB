    "/images/boletin-precios/"
  ],
  "adapter_positive_patterns": [
    "estadisticas-del-sector",
    "/images/estadisticas/",
    "boletin-de-precios",
    "boletin-precios",
    "/images/boletin-precios/"
  ],
  "force_keep_url_patterns": [
