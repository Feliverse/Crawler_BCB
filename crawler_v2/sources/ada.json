  ],
  "low_priority_keywords": [
    "notas-de-prensa",
    "anuncios",
    "recetas",
    "recetarios",
    "memorias"
  ],
  "pagination_yield": {
    "enabled": true,
    "zero_yield_stop_after": 3,
